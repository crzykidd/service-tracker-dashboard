# Copy to .env next to docker-compose.example.yml and fill in.

# The register token: STD's API_TOKEN, and STD_API_TOKEN on every notifier.
API_TOKEN=change-me-register-token

# Signs session cookies. Generate one with: openssl rand -hex 32
FLASK_SECRET_KEY=change-me-long-random

# Local time for the daily jobs.
TZ=UTC

# This host's name or IP as the notifier should link to STD (the STD entry's internal URL).
STD_HOST=localhost
